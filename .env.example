# Copy to .env and replace every REQUIRED_* value before starting Compose.
# Never commit the resulting .env file.
APP_ENV=production
POSTGRES_DB=policy_assistant
POSTGRES_USER=policy
POSTGRES_PASSWORD=REQUIRED_GENERATE_A_UNIQUE_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://policy:REQUIRED_DATABASE_PASSWORD@db:5432/policy_assistant
SESSION_SECRET=REQUIRED_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
FRONTEND_ORIGINS=http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1,api
UPLOAD_ROOT=/app/uploads
MAX_UPLOAD_BYTES=20971520
MODEL_BASE_URL=https://REQUIRED_OPENAI_COMPATIBLE_HOST/v1
MODEL_API_KEY=REQUIRED_PROVIDER_SECRET
CHAT_MODEL=REQUIRED_CHAT_MODEL_NAME
MODEL_DISABLE_THINKING=true
# Local multilingual-e5-small embedding runtime (384 dimensions)
# Relative paths are resolved from compose.yaml. The directory must contain an onnx/ subdirectory.
LOCAL_MODEL_ROOT=./models/multilingual-e5-small
LOCAL_MODEL_THREADS=4
MODEL_TIMEOUT_SECONDS=30
RETRIEVAL_TOP_K=8
EVIDENCE_THRESHOLD=0.72
LOGIN_RATE_LIMIT_PER_MINUTE=10
QUESTION_RATE_LIMIT_PER_MINUTE=20
TOOL_MAX_MODEL_CALLS=3
TOOL_MAX_READ_CALLS=4
TOOL_CONFIRMATION_TTL_SECONDS=600
HR_TURN_RATE_LIMIT_PER_MINUTE=20
HR_CONFIRMATION_RATE_LIMIT_PER_MINUTE=10
WEB_PORT=8080
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=REQUIRED_GENERATE_A_UNIQUE_ADMIN_PASSWORD
DEMO_EMPLOYEE_USERNAME=employee
DEMO_EMPLOYEE_PASSWORD=REQUIRED_GENERATE_A_UNIQUE_EMPLOYEE_PASSWORD
HR_DEMO_ALICE_PASSWORD=REQUIRED_GENERATE_A_UNIQUE_HR_EMPLOYEE_PASSWORD
HR_DEMO_HELEN_PASSWORD=REQUIRED_GENERATE_A_UNIQUE_HR_REVIEWER_PASSWORD
HR_DEMO_ADMIN_PASSWORD=REQUIRED_GENERATE_A_UNIQUE_HR_ADMIN_PASSWORD
PROCUREMENT_DEMO_MANAGER_PASSWORD=REQUIRED_GENERATE_A_UNIQUE_PROCUREMENT_MANAGER_PASSWORD
PROCUREMENT_DEMO_SPECIALIST_PASSWORD=REQUIRED_GENERATE_A_UNIQUE_PROCUREMENT_SPECIALIST_PASSWORD
